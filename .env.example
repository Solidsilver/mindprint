# Mindprint configuration — copy to .env and fill in what you need.
#   cp .env.example .env
# `npm run dev` picks .env up automatically (SvelteKit/Vite);
# `npm start` runs the production build with it via node --env-file.
# In production on NixOS, use services.mindprint.environmentFile instead.

# --- Server ---
# Port for the production server (`npm start`); dev always uses 5173.
#PORT=3000

# Public origin — REQUIRED behind a reverse proxy so share links and
# OG image URLs are generated correctly. Leave unset for local work.
#ORIGIN=https://mindprint.example.com

# Where the SQLite database lives (default: ./data)
#DATA_DIR=./data

# Where the OG-renderer TTFs live (default: <cwd>/fonts)
#FONT_DIR=./fonts

# --- LLM narratives (optional) ---
# Any OpenAI-compatible endpoint. Without OPENAI_API_KEY the narrative
# feature silently disables and deterministic profiles are used.
# NOTE: OPENAI_MODEL must be a model YOUR provider serves, in its naming
# scheme — e.g. OpenAI: gpt-4o-mini · Fireworks:
# accounts/fireworks/models/llama-v3p3-70b-instruct · OpenRouter:
# meta-llama/llama-3.3-70b-instruct · Ollama: llama3.2
#OPENAI_BASE_URL=https://api.openai.com/v1
#OPENAI_API_KEY=sk-...
#OPENAI_MODEL=gpt-4o-mini
